#!/usr/bin/env bash
set -euo pipefail

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" == "refs/heads/main" || "$remote_ref" == "refs/heads/master" ]]; then
    echo "BLOCKED: pushing directly to $remote_ref is not allowed" >&2
    exit 1
  fi
done

scripts/verify.sh
